# Copia este archivo a .env y ejecuta: chmod 600 .env
# Este archivo contiene EJEMPLOS. NO uses cuentas reales en GitHub.
# Los valores NO se ejecutan como codigo shell; no usar "export ".
# Protege .env con chmod 600 y NO lo subas al repositorio.
SMTP_HOST=smtp.example.org
SMTP_PORT=587
# STARTTLS (587) o SSL (465). Nunca texto plano.
SMTP_SECURITY=starttls
SMTP_USER=cuenta@example.org
SMTP_PASSWORD=REEMPLAZAR_CON_CLAVE_O_PASSWORD_DE_APLICACION
MAIL_FROM=cuenta@example.org
MAIL_TO=destinatario@example.org
